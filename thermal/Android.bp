// SPDX-License-Identifier: Apache-2.0
cc_binary {
    name: "android.hardware.thermal-service.libra",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.thermal-service.libra.rc"],
    vintf_fragments: ["android.hardware.thermal-service.libra.xml"],
    srcs: ["service.cpp", "Thermal.cpp", "Sensors.cpp"],
    static_libs: ["android.hardware.thermal-V1-ndk", "libbase"],
    shared_libs: ["libbinder_ndk", "liblog"],
    stl: "c++_static",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
